# Copy to `.env` (same directory as the scripts) and fill in.
#
# `.env` is git-ignored, and so is every variant of it — `.env.bak`,
# `.env.local`, `.env.hold`. A sibling repo in this family committed a
# `.env.hold` with a live key in it, and another had an untracked one
# sitting in a public repo for hours; `.gitignore` here uses `.env*` with
# a `!.env.example` exception so a renamed copy cannot slip through.
#
# Credentials NEVER go on a command line. A secret in argv is readable by
# anything that can run `ps` and lands in shell history, so every value
# here is read by env_config.py and passed to the driver's own fields.
#
# Check what was picked up, without printing any of it:
#
#     python3 env_config.py
#
# Precedence, highest first: an explicit flag, then an exported
# environment variable, then this file, then the default. A `.env` must
# never override something you typed, and an already-exported variable —
# a CI secret, direnv, your shell profile — must never be clobbered by a
# file someone forgot to delete.

# ---------------------------------------------------------------------------
# YOU DO NOT NEED ANY OF THESE TO SCRAPE COMMENTS
# ---------------------------------------------------------------------------
# Measured 2026-09-21 from a bare datacentre address in Finland, with no
# key, no proxy and no account: 60 consecutive InnerTube pages, 1,200
# comments, zero refusals. Everything below buys volume, a specific
# country, or somewhere to run a browser — not access.

# 2Captcha API key. One key, four separately billed products: captcha
# solving, the Scraping Browser API, proxies and fingerprints.
# Used by --twocaptcha-key, --fingerprint and scraper_api_client.py.
TWOCAPTCHA_KEY=

# A proxy for the run. Shape, not a working value:
#     http://{user}:{password}@{country}.proxy.2captcha.com:2334
# Left blank on purpose. A `{...}` placeholder is treated as UNSET by
# env_config.py, so copying this file and running produces the default
# behaviour rather than a 401 a long way from its cause.
YOUTUBE_PROXY=

# The 2Captcha Scraping Browser API endpoint, for --cdp-endpoint. Shape:
#   ws://{login}-zone-scraping_browser-country-{cc}-pid-{profileId}:{password}@cb.2captcha.com:9222
#
# `country-` picks the exit country; `pid-` is a profile with persistent
# cookies and ONE live connection each, so several concurrent runs need
# several pids. A profile's credentials last about a day, which is why no
# working endpoint is pasted anywhere in this repo — it would be stale
# before you read it.
#
# Note: the Selenium engine cannot use this. chromedriver's
# `debuggerAddress` takes a bare host:port with nowhere to put a
# password. Use the Playwright or pyppeteer engine.
YOUTUBE_CDP_ENDPOINT=

# A default target, so `--url` can be left off. A video URL or a bare
# 11-character video id for --mode comments and --mode video; the search
# query for --mode search. NOT a credential, so unlike everything above it
# is shipped with a real, usable value.
YOUTUBE_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ
